# ==========================================
# General
# ==========================================
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:4000

# ==========================================
# Database
# ==========================================
DATABASE_URL=postgresql://user:password@localhost:5432/layboka

# ==========================================
# Auth
# ==========================================
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d
ENCRYPTION_KEY=replace_with_a_32_byte_hex_key

# ==========================================
# Shopify
# ==========================================
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=http://localhost:4000
SHOPIFY_API_VERSION=2025-01
SHOPIFY_SCOPES=read_products,read_orders,read_customers,read_inventory
SHOPIFY_WEBHOOK_SECRET=

# ==========================================
# Anthropic Claude API
# ==========================================
ANTHROPIC_API_KEY=

# Model IDs are configurable so they can be upgraded without code changes.
# Starter/Growth use Haiku (cost-efficient for high-volume, simpler queries).
# Premium/Enterprise/Trial use Sonnet (sharper reasoning for VIP-tier plans).
CLAUDE_STARTER_MODEL=claude-haiku-4-5-20251001
CLAUDE_GROWTH_MODEL=claude-haiku-4-5-20251001
CLAUDE_PREMIUM_MODEL=claude-sonnet-5
CLAUDE_ENTERPRISE_MODEL=claude-sonnet-5
CLAUDE_TRIAL_MODEL=claude-sonnet-5

# ==========================================
# Stripe
# ==========================================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_PRICE_ID=
STRIPE_GROWTH_PRICE_ID=
STRIPE_PREMIUM_PRICE_ID=

# ==========================================
# Email
# ==========================================
EMAIL_PROVIDER_KEY=
EMAIL_FROM=hello@layboka.ai
ADMIN_EMAIL=admin@layboka.ai

# ==========================================
# Trial
# ==========================================
TRIAL_LENGTH_DAYS=7
